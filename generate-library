const fs = require("fs");
const path = require("path");

const templateFolder = path.join(__dirname, "Templates");
const outputFile = path.join(__dirname, "Library", "tagLibrary.json");

const tags = {};

// Read all HTML files
const files = fs.readdirSync(templateFolder)
    .filter(file => file.endsWith(".html"));

for (const file of files) {

    const content = fs.readFileSync(
        path.join(templateFolder, file),
        "utf8"
    );

    // Find all {{TagName}} placeholders
    const matches = content.match(/\{\{[^}]+\}\}/g);

    if (!matches) continue;

    matches.forEach(match => {

        const tagName = match
            .replace("{{", "")
            .replace("}}", "")
            .trim();

        if (!tags[tagName]) {

            tags[tagName] = {
                type: "",
                description: ""
            };
        }
    });
}

// Save dictionary
fs.writeFileSync(
    outputFile,
    JSON.stringify(tags, null, 4)
);

console.log(
    `Generated library with ${Object.keys(tags).length} tags`
);